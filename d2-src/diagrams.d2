# ═════════════════════════════════════════════════════════════
#  RPL106 — Pertemuan 2 · ER Diagram
#  Marker:  # ===== name =====  →  static/d2/<name>.svg
# ═════════════════════════════════════════════════════════════


# ===== erd-siklus =====
direction: right

req: "1. Requirement Analysis" {
  shape: rectangle
  style: {fill: "#E3F2FD"; stroke: "#1976D2"; stroke-width: 2; border-radius: 6}
}
erd: "2. Conceptual Design (ER)" {
  shape: rectangle
  style: {fill: "#FFE0B2"; stroke: "#E65100"; stroke-width: 3; border-radius: 6; bold: true}
}
logical: "3. Logical Design (Relasional)" {
  shape: rectangle
  style: {fill: "#E3F2FD"; stroke: "#1976D2"; stroke-width: 2; border-radius: 6}
}
physical: "4. Physical Design (Index, Storage)" {
  shape: rectangle
  style: {fill: "#E3F2FD"; stroke: "#1976D2"; stroke-width: 2; border-radius: 6}
}

req -> erd -> logical -> physical: {style.stroke: "#455A64"; style.stroke-width: 2}


# ===== erd-pegawai-basic =====
direction: down

pegawai: PEGAWAI {
  shape: sql_table
  style: {fill: "#E3F2FD"; stroke: "#1976D2"; stroke-width: 2; border-radius: 6}
  nopeg: "PK"
  nama: "string"
  alamat: "string"
}


# ===== erd-pegawai-composite =====
direction: right

pegawai: PEGAWAI {
  shape: rectangle
  style: {fill: "#E3F2FD"; stroke: "#1976D2"; stroke-width: 3; border-radius: 6; bold: true}
}
nopeg: "nopeg (PK)" {
  shape: oval
  style: {fill: "#FFF9C4"; stroke: "#F9A825"; stroke-width: 2}
}
nama: nama {
  shape: oval
  style: {fill: "#E8F5E9"; stroke: "#43A047"; stroke-width: 2}
}
namadpn: namadpn {shape: oval; style: {fill: "#E8F5E9"; stroke: "#43A047"}}
namablkg: namablkg {shape: oval; style: {fill: "#E8F5E9"; stroke: "#43A047"}}
tgllahir: tgllahir {shape: oval; style: {fill: "#F5F5F5"; stroke: "#757575"}}
notelp: notelp {
  shape: oval
  style: {fill: "#FCE4EC"; stroke: "#C2185B"; stroke-width: 3; stroke-dash: 3}
}
umur: umur {
  shape: oval
  style: {fill: "#F3E5F5"; stroke: "#8E24AA"; stroke-width: 2; stroke-dash: 5}
}

pegawai -> nopeg
pegawai -> nama
nama -> namadpn
nama -> namablkg
pegawai -> tgllahir
pegawai -> notelp
pegawai -> umur



# ===== erd-keys-flow =====
direction: right

superkey: "SUPERKEY\n\nAtribut yang nilainya\nunik per entitas" {
  shape: rectangle
  style: {fill: "#E3F2FD"; stroke: "#1976D2"; stroke-width: 2; border-radius: 6}
}
candidate: "CANDIDATE KEY\n\nSuperkey paling minimal" {
  shape: rectangle
  style: {fill: "#FFE0B2"; stroke: "#E65100"; stroke-width: 2; border-radius: 6}
}
pk: "PRIMARY KEY\n\nCandidate key yang dipilih" {
  shape: rectangle
  style: {fill: "#C8E6C9"; stroke: "#2E7D32"; stroke-width: 3; border-radius: 6; bold: true}
}

superkey -> candidate: "minimalitas"
candidate -> pk: "pilih satu"

ex1: "{nopeg}\n{nopeg, nama}\n{nopeg, tgllahir}" {
  shape: text
  style: {font-size: 12; font-color: "#1976D2"}
}
ex2: "{nopeg}\n{email}" {
  shape: text
  style: {font-size: 12; font-color: "#E65100"}
}
ex3: "{nopeg}" {
  shape: text
  style: {font-size: 12; font-color: "#2E7D32"; bold: true}
}

superkey -> ex1: {style.stroke: transparent}
candidate -> ex2: {style.stroke: transparent}
pk -> ex3: {style.stroke: transparent}


